#!/data/data/com.termux/files/usr/bin/bash
#
# Standalone Zero-Gradle Android APK Builder for Termux
# Rapid sub-second APK synthesis without heavy Gradle JVM memory overhead.
# Features:
#   - Direct AAPT2 compilation and linking
#   - Multi-DEX conversion via D8 with external JAR dependency support
#   - Kotlin detection and compilation
#   - Direct kernel mmap with uncompressed .so libraries
#   - Android 15/16 16KB page alignment (zipalign -P 16 -f 4)
#   - APK v1/v2 signing via apksigner
#   - Instant on-device deployment via ADB (-i / --install)
#

set -Eeuo pipefail

# Ensure environment
[[ -f "$HOME/.android-env" ]] && source "$HOME/.android-env"

ANDROID_HOME="${ANDROID_HOME:-/data/data/com.termux/files/usr/opt/android-sdk}"
BUILD_TOOLS_VERSION="36.1.0"
PLATFORM_JAR="$ANDROID_HOME/platforms/android-36/android.jar"

# Pre-flight tool check
for cmd in aapt2 javac d8 apksigner zip keytool; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        printf '\033[0;31m[ERROR]\033[0m Required tool %s is not available on PATH.\n' "$cmd" >&2
        exit 1
    fi
done

if [[ ! -f "$PLATFORM_JAR" ]]; then
    printf '\033[0;31m[ERROR]\033[0m Android platform JAR not found at %s\n' "$PLATFORM_JAR" >&2
    exit 1
fi

# Defaults
MANIFEST="AndroidManifest.xml"
SRC_DIR="src"
RES_DIR=""
LIB_DIR=""
JAR_DIR=""
PROJECT_DIR=""
OUTPUT_APK="app-signed.apk"
KEYSTORE=""
KEY_ALIAS="debug"
KEY_PASS="android"
MIN_SDK=""
TARGET_SDK=""
DO_INSTALL=0
DO_SHARE=0
BUILD_DIR="${TMPDIR:-/data/data/com.termux/files/usr/tmp}/apk-build-$$"

show_help() {
    printf 'Usage: %s [OPTIONS]\n\n' "$(basename "$0")"
    printf 'Options:\n'
    printf '  -p, --project <dir>    Android Studio / Gradle project root directory (auto-detects paths)\n'
    printf '  -m, --manifest <file>  Path to AndroidManifest.xml (default: AndroidManifest.xml)\n'
    printf '  -s, --src <dir>        Path to Java/Kotlin source directory (default: src)\n'
    printf '  -r, --res <dir>        Path to Android resources directory (optional)\n'
    printf '  -l, --lib <dir>        Path to native libraries directory containing lib/<abi>/*.so (optional)\n'
    printf '  -j, --jars <path>      Path to JAR file or directory containing external dependencies (optional)\n'
    printf '  -o, --output <file>    Path for output signed APK (default: app-signed.apk)\n'
    printf '  -i, --install          Automatically install APK via adb upon successful build\n'
    printf '  -u, --share            Share/install APK via Android package installer\n'
    printf '      --min-sdk <num>    Set minimum SDK version (passed to aapt2 link)\n'
    printf '      --target-sdk <num> Set target SDK version (passed to aapt2 link)\n'
    printf '  -k, --keystore <file>  Path to signing keystore (default: auto-generated debug)\n'
    printf '      --alias <name>     Keystore key alias (default: debug)\n'
    printf '      --pass <password>  Keystore password (default: android)\n'
    printf '  -h, --help             Display this help message\n'
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--project)    PROJECT_DIR="$2"; shift 2 ;;
        -m|--manifest)   MANIFEST="$2"; shift 2 ;;
        -s|--src)        SRC_DIR="$2"; shift 2 ;;
        -r|--res)        RES_DIR="$2"; shift 2 ;;
        -l|--lib)        LIB_DIR="$2"; shift 2 ;;
        -j|--jars)       JAR_DIR="$2"; shift 2 ;;
        -o|--output)     OUTPUT_APK="$2"; shift 2 ;;
        -i|--install)    DO_INSTALL=1; shift ;;
        -u|--share)      DO_SHARE=1; shift ;;
        --min-sdk)       MIN_SDK="$2"; shift 2 ;;
        --target-sdk)    TARGET_SDK="$2"; shift 2 ;;
        -k|--keystore)   KEYSTORE="$2"; shift 2 ;;
        --alias)         KEY_ALIAS="$2"; shift 2 ;;
        --pass)          KEY_PASS="$2"; shift 2 ;;
        -h|--help)       show_help ;;
        *) printf '\033[0;31m[ERROR]\033[0m Unknown option: %s\n' "$1" >&2; exit 1 ;;
    esac
done

# Auto-detect Android Studio / Gradle project structures
if [[ -n "$PROJECT_DIR" && -d "$PROJECT_DIR" ]]; then
    if [[ -f "$PROJECT_DIR/app/src/main/AndroidManifest.xml" ]]; then
        MANIFEST="$PROJECT_DIR/app/src/main/AndroidManifest.xml"
        SRC_DIR="$PROJECT_DIR/app/src/main/java"
        [[ -d "$PROJECT_DIR/app/src/main/res" ]] && RES_DIR="$PROJECT_DIR/app/src/main/res"
        [[ -d "$PROJECT_DIR/app/src/main/jniLibs" ]] && LIB_DIR="$PROJECT_DIR/app/src/main/jniLibs"
        [[ -d "$PROJECT_DIR/app/libs" && -z "$JAR_DIR" ]] && JAR_DIR="$PROJECT_DIR/app/libs"
    elif [[ -f "$PROJECT_DIR/src/main/AndroidManifest.xml" ]]; then
        MANIFEST="$PROJECT_DIR/src/main/AndroidManifest.xml"
        SRC_DIR="$PROJECT_DIR/src/main/java"
        [[ -d "$PROJECT_DIR/src/main/res" ]] && RES_DIR="$PROJECT_DIR/src/main/res"
        [[ -d "$PROJECT_DIR/src/main/jniLibs" ]] && LIB_DIR="$PROJECT_DIR/src/main/jniLibs"
        [[ -d "$PROJECT_DIR/libs" && -z "$JAR_DIR" ]] && JAR_DIR="$PROJECT_DIR/libs"
    fi
fi

[[ -f "$MANIFEST" ]] || { printf '\033[0;31m[ERROR]\033[0m Manifest not found: %s\n' "$MANIFEST" >&2; exit 1; }
[[ -d "$SRC_DIR" ]] || { printf '\033[0;31m[ERROR]\033[0m Source directory not found: %s\n' "$SRC_DIR" >&2; exit 1; }

mkdir -p "$BUILD_DIR/classes" "$BUILD_DIR/gen"
trap 'rm -rf "$BUILD_DIR"' EXIT INT TERM

printf '\033[0;34m[INFO]\033[0m Compiling resources with AAPT2...\n'
AAPT_ARGS=("-I" "$PLATFORM_JAR" "--manifest" "$MANIFEST" "--java" "$BUILD_DIR/gen" "-o" "$BUILD_DIR/app-unaligned.apk")

[[ -n "$MIN_SDK" ]] && AAPT_ARGS+=("--min-sdk-version" "$MIN_SDK")
[[ -n "$TARGET_SDK" ]] && AAPT_ARGS+=("--target-sdk-version" "$TARGET_SDK")

if [[ -n "$RES_DIR" && -d "$RES_DIR" ]]; then
    mkdir -p "$BUILD_DIR/compiled-res"
    aapt2 compile --dir "$RES_DIR" -o "$BUILD_DIR/compiled-res.zip"
    AAPT_ARGS+=("-R" "$BUILD_DIR/compiled-res.zip")
fi

aapt2 link "${AAPT_ARGS[@]}"

# Build compilation classpath and collect extra JARs
CLASSPATH="$PLATFORM_JAR"
EXTRA_JARS=()
if [[ -n "$JAR_DIR" ]]; then
    if [[ -f "$JAR_DIR" ]]; then
        EXTRA_JARS+=("$JAR_DIR")
        CLASSPATH="$CLASSPATH:$JAR_DIR"
    elif [[ -d "$JAR_DIR" ]]; then
        while IFS= read -r jar_file; do
            [[ -n "$jar_file" ]] || continue
            EXTRA_JARS+=("$jar_file")
            CLASSPATH="$CLASSPATH:$jar_file"
        done < <(find "$JAR_DIR" -type f -name "*.jar" 2>/dev/null)
    fi
    if [[ ${#EXTRA_JARS[@]} -gt 0 ]]; then
        printf '\033[0;34m[INFO]\033[0m Loaded %d external JAR dependencies into build classpath.\n' "${#EXTRA_JARS[@]}"
    fi
fi

# Kotlin sources
mapfile -t KT_FILES < <(find "$SRC_DIR" -name "*.kt" 2>/dev/null)
if [[ ${#KT_FILES[@]} -gt 0 ]]; then
    if command -v kotlinc >/dev/null 2>&1; then
        printf '\033[0;34m[INFO]\033[0m Compiling %d Kotlin source files with kotlinc...\n' "${#KT_FILES[@]}"
        kotlinc -cp "$CLASSPATH" -d "$BUILD_DIR/classes" "${KT_FILES[@]}"
    else
        printf '\033[1;33m[WARNING]\033[0m %d Kotlin (.kt) files detected, but kotlinc is not installed (run "pkg install kotlin").\n' "${#KT_FILES[@]}"
    fi
fi

# Java sources
mapfile -t JAVA_FILES < <(find "$SRC_DIR" "$BUILD_DIR/gen" -name "*.java" 2>/dev/null)
if [[ ${#JAVA_FILES[@]} -gt 0 ]]; then
    printf '\033[0;34m[INFO]\033[0m Compiling %d Java source files...\n' "${#JAVA_FILES[@]}"
    javac -cp "$CLASSPATH" -d "$BUILD_DIR/classes" "${JAVA_FILES[@]}"
fi

mapfile -t CLASS_FILES < <(find "$BUILD_DIR/classes" -name "*.class" 2>/dev/null)
if [[ ${#CLASS_FILES[@]} -eq 0 && ${#EXTRA_JARS[@]} -eq 0 ]]; then
    printf '\033[0;31m[ERROR]\033[0m No compiled .class files or JAR dependencies to convert to DEX.\n' >&2
    exit 1
fi

printf '\033[0;34m[INFO]\033[0m Converting bytecode to Dalvik DEX (d8)...\n'
d8 --lib "$PLATFORM_JAR" --output "$BUILD_DIR" "${CLASS_FILES[@]}" "${EXTRA_JARS[@]}"

printf '\033[0;34m[INFO]\033[0m Packaging DEX into APK...\n'
(cd "$BUILD_DIR" && zip -uq app-unaligned.apk classes*.dex)

# Native shared libraries stored uncompressed for Android runtime direct mmap
if [[ -n "$LIB_DIR" && -d "$LIB_DIR" ]]; then
    printf '\033[0;34m[INFO]\033[0m Packaging uncompressed native libraries from %s (16KB mmap)...\n' "$LIB_DIR"
    if [[ -d "$LIB_DIR/lib" ]]; then
        (cd "$LIB_DIR" && zip -0rq "$BUILD_DIR/app-unaligned.apk" lib/)
    elif [[ -d "$LIB_DIR/arm64-v8a" ]]; then
        mkdir -p "$BUILD_DIR/pack_lib/lib"
        cp -rf "$LIB_DIR" "$BUILD_DIR/pack_lib/lib/"
        (cd "$BUILD_DIR/pack_lib" && zip -0rq "$BUILD_DIR/app-unaligned.apk" lib/)
    else
        (cd "$LIB_DIR" && zip -0rq "$BUILD_DIR/app-unaligned.apk" .)
    fi
fi

if [[ -z "$KEYSTORE" ]]; then
    KEYSTORE="$HOME/.android/debug.keystore"
    if [[ ! -f "$KEYSTORE" ]]; then
        mkdir -p "$(dirname "$KEYSTORE")"
        keytool -genkey -v -keystore "$KEYSTORE" \
            -alias "$KEY_ALIAS" -keyalg RSA -keysize 2048 -validity 10000 \
            -storepass "$KEY_PASS" -keypass "$KEY_PASS" \
            -dname "CN=Android Debug,O=Android,C=US" >/dev/null 2>&1
    fi
fi

# Ensure 4-byte and 16KB page alignment (Android 15+ compatible)
SIGN_TARGET="$BUILD_DIR/app-unaligned.apk"
if command -v zipalign >/dev/null 2>&1; then
    printf '\033[0;34m[INFO]\033[0m Aligning APK with zipalign (16KB page alignment / Android 15+)...\n'
    zipalign -P 16 -f 4 "$BUILD_DIR/app-unaligned.apk" "$BUILD_DIR/app-aligned.apk"
    SIGN_TARGET="$BUILD_DIR/app-aligned.apk"
fi

printf '\033[0;34m[INFO]\033[0m Signing APK with apksigner...\n'
mkdir -p "$(dirname "$OUTPUT_APK")"
apksigner sign --ks "$KEYSTORE" \
    --ks-key-alias "$KEY_ALIAS" \
    --ks-pass "pass:$KEY_PASS" \
    --key-pass "pass:$KEY_PASS" \
    --out "$OUTPUT_APK" \
    "$SIGN_TARGET"

apksigner verify "$OUTPUT_APK" >/dev/null 2>&1

if command -v zipalign >/dev/null 2>&1; then
    zipalign -c -P 16 4 "$OUTPUT_APK" >/dev/null 2>&1 || true
fi

printf '\033[0;32m[SUCCESS]\033[0m Signed APK successfully generated at: %s\n' "$OUTPUT_APK"

# Copy absolute path to Android clipboard if available
if command -v termux-clipboard-set >/dev/null 2>&1; then
    abs_apk="$(cd "$(dirname "$OUTPUT_APK")" 2>/dev/null && pwd)/$(basename "$OUTPUT_APK")"
    termux-clipboard-set "$abs_apk" 2>/dev/null || true
    printf '\033[0;34m[INFO]\033[0m APK path copied to Android clipboard: %s\n' "$abs_apk"
fi

# Send notification if available
if command -v termux-notification >/dev/null 2>&1; then
    termux-notification --id "apk-build" --title "APK Build Complete" --content "Generated: $(basename "$OUTPUT_APK") (16KB aligned & signed)" --priority high 2>/dev/null || true
fi

# Haptic feedback if available
if command -v termux-vibrate >/dev/null 2>&1; then
    termux-vibrate -d 150 2>/dev/null || true
fi

if [[ "$DO_INSTALL" == "1" ]]; then
    if command -v adb >/dev/null 2>&1; then
        printf '\033[0;34m[INFO]\033[0m Installing APK to connected device via adb...\n'
        adb install -r "$OUTPUT_APK" || printf '\033[1;33m[WARNING]\033[0m adb install failed; ensure a device/emulator is connected.\n'
    else
        printf '\033[1;33m[WARNING]\033[0m adb is not available; cannot auto-install APK.\n'
    fi
fi

if [[ "$DO_SHARE" == "1" ]]; then
    if command -v termux-share >/dev/null 2>&1; then
        printf '\033[0;34m[INFO]\033[0m Sharing APK via Android Sharesheet / Package Installer...\n'
        termux-share -a view -c "application/vnd.android.package-archive" "$OUTPUT_APK" || true
    else
        printf '\033[1;33m[WARNING]\033[0m termux-share is not available (install termux-api).\n'
    fi
fi

